# ひかげナビ (Hikage Navi) — environment configuration
# Copy to .env.local for development. NEVER commit real credentials.
# All variables are optional; anything unset is either disabled or (in development only)
# falls back to a public demo endpoint.

# --- General -----------------------------------------------------------------
# Public demo/free endpoints (FOSSGIS OSRM, overpass-api.de, Open-Meteo free API,
# nominatim.openstreetmap.org, GSI, MoE WBGT CSV) are used automatically when NODE_ENV
# is not "production". In production they are OFF unless you set this to "true".
# Check each provider's terms before enabling this for a public/commercial site.
ALLOW_PUBLIC_DEMO_ENDPOINTS=

# --- Site & operator (shown on /terms, /privacy, /contact) ----------------------
# Public URL of the site. Also used to build the User-Agent sent to external services.
SITE_URL=
# Operator name (person or company), contact e-mail and/or contact form URL,
# and the competent court for the terms (e.g. 東京地方裁判所).
SITE_OPERATOR_NAME=
CONTACT_EMAIL=
CONTACT_FORM_URL=
LEGAL_COURT=
# Set to "true" only after the terms and privacy policy have been reviewed by a
# professional. Until then (or while operator/contact are empty) the pages show a
# "draft" banner.
LEGAL_REVIEWED=

# Identify your deployment to upstream services (required by OSM/Nominatim/Overpass policies).
# Optional: if empty, "hikage-navi/1.0 (+SITE_URL)" is used.
HTTP_USER_AGENT=

# Timeout for each upstream request (ms) and per-IP request budget per minute.
PROVIDER_TIMEOUT_MS=12000
RATE_LIMIT_PER_MINUTE=30
# Route searches only (they use the free public services the most). A departure
# comparison counts once per departure time. The daily cap stops one person from
# using up the whole site's daily allowance of Overpass / Open-Meteo.
RATE_LIMIT_SEARCHES_PER_MINUTE=10
RATE_LIMIT_SEARCHES_PER_DAY=300

# --- Shared rate limiting (recommended when running more than one instance) -------
# Upstash Redis REST credentials (free tier is enough). Without them, each server
# instance counts requests on its own. IPs are hashed with RATE_LIMIT_SALT before
# they are sent; set the salt to any long random string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# --- Operator status page -------------------------------------------------------
# In production, GET /api/v1/providers/status answers only with
# "Authorization: Bearer <STATUS_TOKEN>"; otherwise it returns 404.
# Leave empty to hide it completely in production. Use a long random string.
STATUS_TOKEN=

# --- Geocoding ---------------------------------------------------------------
# Set either to "none" to disable that geocoder.
GSI_GEOCODER_URL=
NOMINATIM_URL=
# Photon (OSM search built for search-as-you-type; used for live suggestions). Public
# photon.komoot.io is fair-use only; self-host for production volume.
PHOTON_URL=

# --- Street routing (OSRM, one server/profile per mode) ------------------------
# Example self-hosted: http://osrm-foot:5000  (path /route/v1/driving/... is appended)
OSRM_CAR_URL=

# --- Trains ----------------------------------------------------------------------
# Default (TRANSIT_PROVIDER empty): estimated train routes on OpenStreetMap railway
# tracks, no timetable. Needs the network file built by `npm run rail:build`
# (data/rail/japan-rail.json.gz). RAIL_NETWORK_PATH overrides the file location.
# TRANSIT_PROVIDER=otp uses OpenTripPlanner 2 (GTFS GraphQL API) instead; load only
# GTFS/GTFS-JP data you are licensed to use. Example: http://otp:8080/otp/gtfs/v1
# TRANSIT_PROVIDER=none disables train search.
RAIL_NETWORK_PATH=
TRANSIT_PROVIDER=
OTP_GRAPHQL_URL=
OTP_API_KEY=

# --- Weather / UV (Open-Meteo) -------------------------------------------------
# WEATHER_PROVIDER=none disables weather. Without an API key the free (non-commercial)
# endpoint is used (development, or when ALLOW_PUBLIC_DEMO_ENDPOINTS=true).
WEATHER_PROVIDER=
OPEN_METEO_API_KEY=
OPEN_METEO_URL=
# Forecasts further ahead than this are not shown (days).
WEATHER_MAX_LEAD_DAYS=7

# --- Official heat index (Ministry of the Environment WBGT forecast) ---------------
# WBGT_PROVIDER=none disables it.
WBGT_PROVIDER=
MOE_WBGT_FORECAST_URL=
JMA_AMEDAS_TABLE_URL=
WBGT_MAX_STATION_KM=25

# --- Shade (OSM buildings via Overpass) ---------------------------------------------
# SHADE_PROVIDER=none disables shade estimation (all shade shows as "unknown").
SHADE_PROVIDER=
OVERPASS_URL=
SHADE_MAX_ROUTE_KM=5
SHADE_TIMEOUT_MS=35000
